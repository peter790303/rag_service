POSTGRES_PASSWORD=replace-with-a-local-secret
PORT=30700
RAG_DATABASE_URL=postgres://rag:replace-with-a-local-secret@127.0.0.1:30684/agent_teams_rag
RAG_DB_SCHEMA=public
RAG_EMBEDDING_DIMENSIONS=384
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_API_URL=
RAG_EMBEDDING_API_KEY=
RAG_JOB_LEASE_SECONDS=300
RAG_WORKER_POLL_MS=1500

RAG_SERVICE_AUTH_SECRET=replace-with-at-least-32-random-characters

# OpenAI-compatible chat completions endpoint used for semantic chunk boundaries
RAG_CHUNKING_MODEL=gpt-6.1-sol
RAG_CHUNKING_API_URL=https://your-model-gateway.example/v1/chat/completions
