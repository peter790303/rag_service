POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_DB=agent_teams_rag
PORT=30700
# Compose 服務之間用 database:5432。主機從外面連已發佈的資料庫時用 127.0.0.1:30684。
RAG_DATABASE_URL=postgres://rag:replace-with-a-local-secret@database:5432/agent_teams_rag
RAG_DB_SCHEMA=public
RAG_EMBEDDING_DIMENSIONS=384
# Original multilingual model, inferred locally from a pre-populated offline cache.
RAG_EMBEDDING_TRANSPORT=local
RAG_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_REVISION=2c4055b12046f11709e9df2c122e59ffbdc2f900
RAG_EMBEDDING_CACHE_DIR=.cache/embeddings
# Optional HTTP transport requires an OpenAI-compatible embeddings endpoint.
# RAG_EMBEDDING_API_URL=
# RAG_EMBEDDING_API_KEY=
RAG_EXTERNAL_REQUEST_TIMEOUT_MS=30000
RAG_JOB_LEASE_SECONDS=300
RAG_WORKER_POLL_MS=1500

RAG_SERVICE_AUTH_SECRET=replace-with-at-least-32-random-characters

# Host absolute Obsidian vault path. Compose mounts the same path read-only into the API container.
OBSIDIAN_ROOT=/Users/xiang/Documents/Worker
# Optional stable project identity for newly discovered Markdown files.
# RAG_OBSIDIAN_PROJECT_ID=worker/obsidian-worker
# RAG_OBSIDIAN_PROJECT_NAME=Worker Obsidian

# Run Codex on the host with its existing login for semantic chunk boundaries.
RAG_CHUNKING_TRANSPORT=host-cli
RAG_CHUNKING_MODEL=gpt-6.1-sol
# Run `npm run start:host-cli` on the host; use a generated secret of at least 32 characters.
# Set bind address to 0.0.0.0 only when Docker must reach the host listener.
RAG_HOST_CLI_BIND_ADDRESS=0.0.0.0
RAG_HOST_CLI_PORT=30701
RAG_HOST_CLI_SHARED_SECRET=
# Optional HTTP transport requires an OpenAI-compatible chat completions URL.
# RAG_CHUNKING_API_URL=
# RAG_CHUNKING_API_KEY=
