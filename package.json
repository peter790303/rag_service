{
  "name": "agent-teams-rag-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "migration:run": "npm run typeorm -- migration:run -d dist/database/data-source.js",
    "test": "tsc --project tsconfig.test.json && node --test \"dist/tests/Unit/**/*.test.js\" \"dist/tests/Feature/**/*.test.js\"",
    "test:integration": "tsc --project tsconfig.test.json && node --env-file-if-exists=.env --test --test-concurrency=1 \"dist/tests/Integration/**/*.test.js\"",
    "start:worker": "node --env-file-if-exists=.env dist/src/worker.js",
    "typeorm": "node --env-file-if-exists=.env node_modules/typeorm/cli.js",
    "migration:revert": "npm run typeorm -- migration:revert -d dist/database/data-source.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,yml,yaml}\" .prettierrc",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,yml,yaml}\" .prettierrc",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=26.8.1 <27",
    "npm": ">=11 <12"
  }
}
